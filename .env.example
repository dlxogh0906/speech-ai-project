# cp .env.example .env  후 자기 환경에 맞게 채운다. `.env` 는 git 에 올라가지 않는다.
# shared/paths.py 가 이 파일을 읽는다. 환경변수가 이미 있으면 그쪽이 우선한다.

# ── 외부 대용량 ─────────────────────────────────────────────
SPEECH_AI_DATA=/path/to/corpus          # AIHub 오디오 + MDD 체크포인트 루트
SPEECH_AI_MODELS=/path/to/models        # xlsr2_2B_1000k.pt (26 GB), xlsr2_300m.pt
FAIRSEQ_ROOT=/path/to/fairseq           # editable 설치된 fairseq 소스 루트

# ── 산출물 (재생성 비쌈 → 저장소 밖에 둔다) ─────────────────
NATIONALITY_OUTPUTS=/path/to/out/nationality   # 특징 캐시·head.pt·ONNX
NATIONALITY_DATA=/path/to/out/nationality/data # split(csv/tsv)
NATIONALITY_RUNS=/path/to/out/nationality/runs # probe/finetune 결과
MDD_OUTPUTS=/path/to/out/mdd                   # manifest_tag_*·예측 캐시·metrics
MDD_ANALYSIS=/path/to/out/mdd/analysis         # records.jsonl·L1-prior
G2P_TOOLS=/path/to/g2p_tools                   # KoG2P / g2pK 클론

# ── 외부 도구 ───────────────────────────────────────────────
FFMPEG_BIN=ffmpeg

# cp .env.example .env  후 자기 환경에 맞게 채운다. `.env` 는 git 에 올라가지 않는다.
# shared/paths.py 와 tools/env.sh 가 같은 파일을 읽는다.
# 이미 설정된 환경변수가 있으면 그쪽이 우선한다.

# ── 외부 대용량 ─────────────────────────────────────────────
# AIHub 오디오 + MDD 체크포인트 루트
SPEECH_AI_DATA=/path/to/corpus
# XLS-R 사전학습 가중치 (xlsr2_2B_1000k.pt 26 GB, xlsr2_300m.pt)
SPEECH_AI_MODELS=/path/to/models
# editable 설치된 fairseq 소스 루트
FAIRSEQ_ROOT=/path/to/fairseq

# ── 산출물 (재생성 비쌈 → 저장소 밖에 둔다) ─────────────────
# 국적: 특징 캐시 · head.pt · ONNX
NATIONALITY_OUTPUTS=/path/to/out/nationality
# 국적: split (csv/tsv)
NATIONALITY_DATA=/path/to/out/nationality/data
# 국적: probe / finetune 결과
NATIONALITY_RUNS=/path/to/out/nationality/runs
# 발음: manifest_tag_* · 예측 캐시 · metrics
MDD_OUTPUTS=/path/to/out/mdd
# 발음: records.jsonl · L1-prior
MDD_ANALYSIS=/path/to/out/mdd/analysis
# KoG2P / g2pK 클론 위치
G2P_TOOLS=/path/to/g2p_tools

# ── 외부 도구 ───────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
# 통합 환경(국적 + 발음)의 파이썬. tools/env.sh 가 $PY 로 export 하고
# deploy/*.sh 가 이걸 쓴다. 비우면 PATH 의 `python` 이 잡힌다.
PY=/path/to/envs/speech-ai/bin/python

# ── 학습 서버 밖에서 추론할 때만 필요한 오버라이드 ──────────
# 체크포인트에 박힌 data 경로는 학습 서버 것이라 다른 머신엔 없다.
# dict.ltr.txt 가 있는 폴더를 지정한다 (가중치 번들의 final/pronunciation/).
MDD_DATA_DIR=/path/to/weights/final/pronunciation
# 국적 KD 인코더(encoder_kd_l17.onnx · head_np.npz) 위치.
# 기본값은 저장소 안 outputs/kd_encoder/run2/deploy 라 배포 머신에선 안 맞는다.
KD_MODEL_DIR=/path/to/weights/final/nationality
